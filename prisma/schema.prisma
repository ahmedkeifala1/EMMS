generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  staff
  head
  admin
  governor
}

enum AudienceType {
  broadcast
  individual
  confidential
}

enum Priority {
  normal
  high
  urgent
}

enum MemoStatus {
  draft
  sent
  acknowledged
}

enum ReceiptType {
  to
  cc
  bcc_head
}

model Department {
  id           String   @id @default(uuid())
  name         String   @unique @db.VarChar(100)
  code         String   @unique @db.VarChar(10)
  headUserId   String?  @map("head_user_id")
  parentDeptId String?  @map("parent_dept_id")
  createdAt    DateTime @default(now()) @map("created_at")

  head       User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  parentDept Department?  @relation("DeptHierarchy", fields: [parentDeptId], references: [id])
  childDepts Department[] @relation("DeptHierarchy")
  users      User[]       @relation("UserDepartment")

  @@map("departments")
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name") @db.VarChar(200)
  email        String   @unique @db.VarChar(200)
  staffId      String   @unique @map("staff_id") @db.VarChar(20)
  password     String   @db.VarChar(255)
  departmentId String   @map("department_id")
  role         UserRole @default(staff)
  mobile       String?  @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  department       Department      @relation("UserDepartment", fields: [departmentId], references: [id])
  headOfDepartment Department[]    @relation("DepartmentHead")
  sentMemos        Memo[]          @relation("MemoSender")
  memoRecipients   MemoRecipient[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Memo {
  id              String       @id @default(uuid())
  referenceNumber String       @unique @map("reference_number") @db.VarChar(30)
  subject         String       @db.VarChar(300)
  body            String       @db.Text
  senderId        String       @map("sender_id")
  audienceType    AudienceType @map("audience_type")
  priority        Priority     @default(normal)
  status          MemoStatus   @default(draft)
  referenceNote   String?      @map("reference_note") @db.VarChar(100)
  isConfidential  Boolean      @default(false) @map("is_confidential")
  createdAt       DateTime     @default(now()) @map("created_at")
  sentAt          DateTime?    @map("sent_at")

  sender     User            @relation("MemoSender", fields: [senderId], references: [id])
  recipients MemoRecipient[]
  auditLogs  AuditLog[]

  @@map("memos")
}

model MemoRecipient {
  id             String      @id @default(uuid())
  memoId         String      @map("memo_id")
  userId         String      @map("user_id")
  receiptType    ReceiptType @map("receipt_type")
  acknowledgedAt DateTime?   @map("acknowledged_at")
  readAt         DateTime?   @map("read_at")
  isArchived     Boolean     @default(false) @map("is_archived")

  memo Memo @relation(fields: [memoId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([memoId, userId])
  @@map("memo_recipients")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  memoId    String?  @map("memo_id")
  action    String   @db.VarChar(50)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")
  metadata  Json?

  user User  @relation(fields: [userId], references: [id])
  memo Memo? @relation(fields: [memoId], references: [id])

  @@map("audit_log")
}
